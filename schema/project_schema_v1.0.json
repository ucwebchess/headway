      "type": "object"
    },
    "EngineeringStatus": {
      "description": "Engineering readiness of the project (not a simulation result).\n\n``REFERENCE_ASSUMPTIONS`` (added in Phase 2) marks a reference project whose\nphysical data follows documented reference assumptions rather than a\nvalidated design. The value is additive: existing documents are unaffected.",
      "enum": [
        "PLANNING",
        "VALIDATED",
        "APPROVED",
        "REFERENCE_ASSUMPTIONS"
      ],
      "title": "EngineeringStatus",
      "type": "string"
    },
