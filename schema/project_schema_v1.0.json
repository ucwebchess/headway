{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/railway-headway-sim/schema/project_schema_v1.0.json",
  "$comment": "Railway Track Headway Simulator project document schema 1.0 (application version 0.2.0). Phase 2 keeps schema 1.0: the typed physical catalogues are additive nested keys inside an infrastructure layer object, so every Phase-1 document remains valid and round-trips unchanged.",
  "title": "Railway headway simulator project document",
  "type": "object",
  "required": [],
  "properties": {
    "schema_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Schema Version"
    },
    "project": {
      "$ref": "#/$defs/ProjectMeta"
    },
    "display_units": {
      "$ref": "#/$defs/DisplayUnits"
    },
    "reference_system": {
      "$ref": "#/$defs/ReferenceSystem"
    },
    "provenance": {
      "$ref": "#/$defs/ProvenanceContainer"
    },
    "infrastructure": {
      "type": "array",
      "description": "Array of infrastructure layer objects (Phase-1 container contract). Layers may carry the typed Phase-2 catalogues described by TypedInfrastructureLayer.",
      "items": {
        "$ref": "#/$defs/TypedInfrastructureLayer"
      },
      "default": []
    },
    "signalling": {
      "$ref": "#/$defs/SignallingContainer"
    },
    "rolling_stock": {
      "$ref": "#/$defs/RollingStockContainer"
    },
    "train_paths": {
      "$ref": "#/$defs/TrainPathsContainer"
    },
    "services": {
      "items": {},
      "title": "Services",
      "type": "array"
    },
    "simulation": {
      "$ref": "#/$defs/SimulationContainer"
    },
    "analysis": {
      "$ref": "#/$defs/AnalysisContainer"
    },
    "scenarios": {
      "items": {},
      "title": "Scenarios",
      "type": "array"
    },
    "reporting": {
      "$ref": "#/$defs/ReportingContainer"
    }
  },
  "unevaluatedProperties": true,
  "additionalProperties": true,
  "x-schema-version": "1.0",
  "x-supported-schema-versions": [
    "1.0"
  ],
  "x-application-version": "0.2.0",
  "x-phase2-typed-catalogues": [
    "alignments",
    "track_groups",
    "horizontal_geometry",
    "vertical_profiles",
    "speed_restrictions",
    "nodes",
    "tracks",
    "stations",
    "platforms",
    "stopping_marks",
    "observation_points"
  ],
  "x-phase1-opaque-catalogues": [
    "chainages",
    "speed_profiles",
    "gradients",
    "curves",
    "tunnels",
    "bridges"
  ],
  "$defs": {
    "AnalysisContainer": {
      "additionalProperties": true,
      "description": "``analysis`` section: analysis configuration placeholders.",
      "properties": {
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "parameters": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parameters"
        }
      },
      "title": "AnalysisContainer",
      "type": "object"
    },
    "ChainageDirection": {
      "description": "Direction in which chainage increases along an infrastructure container.",
      "enum": [
        "INCREASING_CHAINAGE",
        "DECREASING_CHAINAGE"
      ],
      "title": "ChainageDirection",
      "type": "string"
    },
    "CurveRadiusConvention": {
      "description": "Convention for the sign/meaning of stored curve radii.",
      "enum": [
        "SIGNED_LEFT_POSITIVE",
        "ABSOLUTE_WITH_DIRECTION"
      ],
      "title": "CurveRadiusConvention",
      "type": "string"
    },
    "DataStatus": {
      "description": "Lifecycle/quality status of the data inside a project container.\n\n``SYNTHETIC`` (added in Phase 2) marks reference/synthetic data that is\ndeliberately *not* a real engineering record, e.g. the GRR-01 reference\nproject. The value is additive: existing documents are unaffected.",
      "enum": [
        "TEMPLATE",
        "DRAFT",
        "ENGINEERING",
        "SYNTHETIC"
      ],
      "title": "DataStatus",
      "type": "string"
    },
    "DisplayUnits": {
      "additionalProperties": true,
      "description": "``display_units`` section: UI/report preferences only.\n\nThese strings never define internal physics units and no conversion is\nperformed in Phase 1.",
